# Copy this file to `.env` to override the defaults.

# SQLite for local development. The default is an absolute path to backend/store.db.
# DATABASE_URL=sqlite:///./store.db

# Comma-separated list of frontend origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication. Generate a strong secret for any non-local environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development admin account created by `python -m app.seed_admin`.
# Change these credentials before deploying.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@furzy.local
ADMIN_PASSWORD=ChangeMe123!
