# Copy this file to `.env` to override the defaults.

# Use "production" in production. Production fails startup if mock
# online payments are enabled.
APP_ENV=development

# SQLite for local development. The default is an absolute path to backend/store.db.
# DATABASE_URL=sqlite:///./store.db

# Comma-separated list of frontend origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Flat shipping fee in LKR for checkout orders.
SHIPPING_FEE_LKR=350

# Authentication. Generate a strong secret for any non-local environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional SMTP notifications for order confirmation and status updates.
# Leave SMTP_HOST empty to skip sending; the API will log and continue.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=orders@example.com
# SMTP_USE_TLS=true

# Online payments: disabled, mock, or payhere.
# mock is for local tests only and must never be enabled in production.
PAYMENT_PROVIDER=disabled
PAYMENT_MOCK_ENABLED=false
PAYMENT_CURRENCY=LKR
FRONTEND_BASE_URL=http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8005

# PayHere merchant credentials. Use sandbox credentials first.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true

# PayHere Merchant API for automatic payment retrieval and refunds.
# Requires an API key with the corresponding permissions and domain/IP
# whitelisting. Leave blank to use the admin manual workflow.
# PAYHERE_API_APP_ID=
# PAYHERE_API_APP_SECRET=
# PAYHERE_API_TIMEOUT_SECONDS=10

# Unpaid online orders release their reserved stock after this many
# minutes. Set to 0 to disable expiry. The in-process sweeper can be
# disabled when an external cron job runs `python -m app.expire_reservations`.
ONLINE_PAYMENT_RESERVATION_MINUTES=30
STOCK_RESERVATION_SWEEP_ENABLED=true
STOCK_RESERVATION_SWEEP_SECONDS=60

# Admin account managed by `python -m app.seed_admin`.
# Replace these placeholders before running the script.
# seed_admin refuses missing, invalid, or known default/placeholder values.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
