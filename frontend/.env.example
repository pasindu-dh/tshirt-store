# Backend API base URL used by the browser.
#
# Local development:
VITE_API_URL=http://127.0.0.1:8005
#
# Production: set this in the Vercel project's Environment Variables to
# the Render service URL, for example:
# VITE_API_URL=https://furzy-api.onrender.com
#
# Vite embeds this value at build time. Redeploy after changing it.
